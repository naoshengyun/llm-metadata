{
  "name": "llm-metadata",
  "version": "1.0.0",
  "description": "A lightweight static API for discovering and integrating LLM metadata",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run compile && node dist/build.js",
    "build:force": "npm run compile && node dist/build.js --force",
    "check": "npm run compile && node dist/build.js --check",
    "translate": "npm run compile && node dist/translate.js",
    "clean": "rimraf .cache dist src/**/*.js src/**/*.d.ts",
    "compile": "tsc",
    "compile:watch": "tsc --watch",
    "dev": "npm run compile:watch",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "test:cny": "tsc --outDir .cache/cny-build && node --test tests/*.test.mjs",
    "cny:generate": "tsc --outDir .cache/cny-build && node .cache/cny-build/cny/cli.js",
    "cny:official:build": "tsc --outDir .cache/cny-build && node scripts/build-official-cny.mjs",
    "cny:unified:build": "tsc --outDir .cache/cny-build && node scripts/build-unified-cny.mjs",
    "cny:official:check": "tsc --outDir .cache/cny-build && node scripts/check-official-cny.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "llm",
    "metadata",
    "api",
    "models",
    "ai"
  ],
  "author": "basellm",
  "license": "MIT"
}
